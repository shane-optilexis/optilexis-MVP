# Sprint 02 no longer ships a fixed identity or database.
# Local development: python3 scripts/create_dev_config.py, then ./scripts/run_api.sh
# .env.local is generated with a cryptographically random token and ignored by Git.
# The app's development sign-in screen accepts that token (no token in Dart sources).
#
# ENV=development
# DATABASE_URL=sqlite+pysqlite:////absolute/path/to/local/optilexis.sqlite
# ALLOW_DEV_AUTH=true
# DEV_AUTH_TOKENS_JSON='{"local-strong-secret":{"sub":"local-user","scope":"journeys:read journeys:write translation:demo"}}'
#
# Production requires PostgreSQL, ALLOW_DEV_AUTH=false, HTTPS OIDC issuer/JWKS,
# API audience, TLS termination, migrations, rate limiting, operational monitoring.
# OIDC_ISSUER=https://identity.example.net/
# OIDC_AUDIENCE=optilexis-api
# OIDC_JWKS_URL=https://identity.example.net/.well-known/jwks.json
# RETENTION_DAYS=30

# OIDC public native-client configuration (no app client secret)
# OPTILEXIS_OIDC_ISSUER=https://your-idp.example/
# OPTILEXIS_OIDC_CLIENT_ID=registered-native-public-client
# OPTILEXIS_OIDC_REDIRECT_URI=ai.optilexis://auth/callback
# OPTILEXIS_OIDC_SCOPES=openid profile offline_access journeys:read journeys:write translation:demo translation:live
# OPTILEXIS_OIDC_AUDIENCE=optilexis-api
# OPTILEXIS_OIDC_AUDIENCE_PARAMETER=audience  # only if IdP requires
# Backend OIDC_ISSUER, OIDC_AUDIENCE and OIDC_JWKS_URL must match actual IdP.
# Azure resource secrets belong only on the server / secret manager:
# TEXT_TRANSLATOR=azure
# AZURE_TRANSLATOR_ENDPOINT=https://resource.cognitiveservices.azure.com/translator/text/v3.0/translate
# AZURE_TRANSLATOR_REGION=eastus
# AZURE_TRANSLATOR_KEY=<secret-not-in-git>
